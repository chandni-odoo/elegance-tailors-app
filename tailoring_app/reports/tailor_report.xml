                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="doc.pant_ids[1].pant_sit"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="doc.pant_ids[2].pant_sit"/></th>
                        </tr>

                        <tr>
