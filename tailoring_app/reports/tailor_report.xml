                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="doc.pant_ids[2].pant_guthna"/></th>
                        </tr>

                        <tr>
                            <th style="text-align:center; font-weight:bold;">F.POCK.</th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>0" t-esc="dict(doc.pant_ids[0]._fields['pant_back_pocket'].selection).get(doc.pant_ids[0].pant_back_pocket)"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="dict(doc.pant_ids[1]._fields['pant_back_pocket'].selection).get(doc.pant_ids[1].pant_back_pocket)"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="dict(doc.pant_ids[2]._fields['pant_back_pocket'].selection).get(doc.pant_ids[2].pant_back_pocket)"/></th>
                        </tr>

                        <tr>
                            <th style="text-align:center; font-weight:bold;">B.POCK.</th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>0" t-esc="dict(doc.pant_ids[0]._fields['pant_back_pocket'].selection).get(doc.pant_ids[0].pant_back_pocket)"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="dict(doc.pant_ids[1]._fields['pant_back_pocket'].selection).get(doc.pant_ids[1].pant_back_pocket)"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="dict(doc.pant_ids[2]._fields['pant_back_pocket'].selection).get(doc.pant_ids[2].pant_back_pocket)"/></th>
                        </tr>

                        <tr>
                            <th style="text-align:center; font-weight:bold;">TYPE</th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>0" t-esc="doc.pant_ids[0].pant_type_id.name"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="doc.pant_ids[1].pant_type_id.name"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="doc.pant_ids[2].pant_type_id.name"/></th>
                        </tr>

                        <tr>
                            <th style="text-align:center; font-weight:bold;">SILAI-TYPE</th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>0" t-esc="doc.pant_ids[0].silai_type_id.name"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="doc.pant_ids[1].silai_type_id.name"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="doc.pant_ids[2].silai_type_id.name"/></th>
                        </tr>

                        <tr>
                            <th style="text-align:center; font-weight:bold;">NOTE</th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>0" t-esc="doc.pant_ids[0].notes"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>1" t-esc="doc.pant_ids[1].notes"/></th>
                            <th  width="24%" style="text-align:left; font-weight:bold;"><t t-if="len(doc.pant_ids)>2" t-esc="doc.pant_ids[2].notes"/></th>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

