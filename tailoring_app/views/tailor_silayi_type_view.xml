<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_tailor_silayi_type_tree" model="ir.ui.view">
        <field name="name">tailor.silayi.type.tree</field>
        <field name="model">tailor.silayi.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="charge_type"/>
            </list>
        </field>
    </record>

    <record id="view_tailor_silayi_type_form" model="ir.ui.view">
        <field name="name">tailor.silayi.type.form</field>
        <field name="model">tailor.silayi.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="charge_type"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tailor_silayi_type" model="ir.actions.act_window">
        <field name="name">Silayi Types</field>
        <field name="res_model">tailor.silayi.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->

    <menuitem id="menu_tailor_silayi_type"
              name="Silayi Type Master"
              parent="tailoring_app.menu_tailor_management"
              action="action_tailor_silayi_type"
              sequence="4"/>

</odoo>
