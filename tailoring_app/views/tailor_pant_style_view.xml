<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_tailor_pant_style_tree" model="ir.ui.view">
        <field name="name">tailor.pant.style.tree</field>
        <field name="model">tailor.pant.style</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="waist_type"/>
                <field name="fit_type"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tailor_pant_style_form" model="ir.ui.view">
        <field name="name">tailor.pant.style.form</field>
        <field name="model">tailor.pant.style</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="waist_type"/>
                            <field name="fit_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_tailor_pant_style" model="ir.actions.act_window">
        <field name="name">Pant Styles</field>
        <field name="res_model">tailor.pant.style</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_tailor_pant_style"
              parent="tailoring_app.menu_tailor_management"
              name="Pant Style Master"
              action="action_tailor_pant_style"
              sequence="2"/>

</odoo>
