<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_tailor_shirt_type_tree" model="ir.ui.view">
        <field name="name">tailor.shirt.type.tree</field>
        <field name="model">tailor.shirt.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="fit_type"/>
                <field name="sleeve_type"/>
                <field name="collar_type"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tailor_shirt_type_form" model="ir.ui.view">
        <field name="name">tailor.shirt.type.form</field>
        <field name="model">tailor.shirt.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="fit_type"/>
                        </group>
                        <group>
                            <field name="sleeve_type"/>
                            <field name="collar_type"/>
                            <field name="price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tailor_shirt_type" model="ir.actions.act_window">
        <field name="name">Shirt Types</field>
        <field name="res_model">tailor.shirt.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->

    <menuitem id="menu_tailor_shirt_type"
              name="Shirt Type Master"
              parent="tailoring_app.menu_tailor_management"
              action="action_tailor_shirt_type"
              sequence="3"/>

</odoo>
